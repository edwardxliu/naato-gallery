{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/_next/image", "destination": "/api/image" }
  ],
  "redirects": [
    { "source": "/elle-intro/:path*", "destination": "/life-intro/:path*", "permanent": true },
    { "source": "/esquire-intro/:path*", "destination": "/objects-intro/:path*", "permanent": true },
    { "source": "/elle/:path*", "destination": "/life/:path*", "permanent": true },
    { "source": "/esquire/:path*", "destination": "/objects/:path*", "permanent": true }
  ]
}
